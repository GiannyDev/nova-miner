# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Juegos de terceros (no commitear). El agente SÍ debe leerlos: ver .cursor/rules/ai-context.mdc
# Godot NO debe compilarlos: REFERENCIA/.gdignore (si no, class_name de YKTD pisan los nuestros).
REFERENCIA/**
!REFERENCIA/.gdignore
